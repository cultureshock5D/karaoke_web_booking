# Appwrite Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=karaoke_booking
NEXT_PUBLIC_APPWRITE_DATABASE_ID=karaoke_db
APPWRITE_API_KEY=your_appwrite_server_api_key

# Appwrite Storage Buckets
NEXT_PUBLIC_APPWRITE_BUCKET_MEDIA=venue_media

# PayMongo (Philippines Payment Gateway - Hosted Checkout v2)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret

# Application & Localization
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Manila

# Slot & Hold Policy
SLOT_HOLD_MINUTES=15
MINIMUM_BOOKING_DEPOSIT_PHP=100
